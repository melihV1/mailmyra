# Bu dosyayı apps/web/.env.local olarak kopyala (Next env'i apps/web içinden yükler)

# Veritabanı — MariaDB 11.8, yalnız localhost.
# Yerel kurulum: brew install mariadb@11.8 && brew services start mariadb@11.8
# Kurulum adımları: docs/local-database.md
DATABASE_URL="mysql://mailmyra:PAROLA@127.0.0.1:3306/mailmyra_dev"
# `prisma migrate dev`in gölge veritabanı. Açıkça veriyoruz ki Prisma'nın
# CREATE/DROP DATABASE yetkisine ihtiyacı olmasın.
SHADOW_DATABASE_URL="mysql://mailmyra:PAROLA@127.0.0.1:3306/mailmyra_shadow"

# Entegrasyon testleri buraya koşar (npm run test:db). Dev verisi bozulmasın.
TEST_DATABASE_URL="mysql://mailmyra:PAROLA@127.0.0.1:3306/mailmyra_test"

# E-posta gönderimi — sağlayıcı BAĞIMSIZ, standart SMTP.
# Sağlayıcı kararı açık (Plesk SMTP / Google Workspace). Kurulum ve iki adayın
# ayarları: docs/email-setup.md
# Boş bırakılırsa geliştirmede mesaj konsola yazılır; ÜRETİMDE uygulama başlamaz.
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=Mailmyra <no-reply@mailmyra.com>
# Röle kimlik doğrulaması istiyorsa ikisi BİRLİKTE doldurulur.
MAIL_USER=
MAIL_PASS=
# Port tahminini ezmek için: 465 örtük TLS, gerisi STARTTLS.
# MAIL_SECURE=

# Pazarlama sitesindeki demo/iletişim formlarından gelen taleplerin
# bildirileceği adres. Boş bırakılırsa lead yine kaydedilir, posta gitmez.
LEADS_NOTIFY_TO=hello@mailmyra.com
# IP başına saatlik talep sınırı (varsayılan 5).
LEADS_RATE_LIMIT_PER_HOUR=5

# Görsel CDN (apps/web)
CDN_WRITE_PATH=./public/cdn-dev
CDN_PUBLIC_URL=http://localhost:3000/cdn-dev
EXPORT_REQUIRES_AUTH=false
UPLOAD_RATE_LIMIT_PER_HOUR=20
CDN_DISK_QUOTA_MB=5120
ORPHAN_TTL_DAYS=7
ICON_RATE_LIMIT_PER_HOUR=60
ICON_COLOR_CAP=256
# Statik pazarlama formlarının hata dönüşü — yerelde de aynı origin.
MARKETING_ORIGIN=http://localhost:3000
