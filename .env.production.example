# PROD ŞABLONU — sunucuda `apps/web/.env.local` olarak kaydedilir.
# (.env*.local git'e girmez; bu şablon referans olsun diye repoda durur.)
#
# Next env dosyalarını `apps/web` KLASÖRÜNDEN yükler — dosyayı repo köküne
# değil, apps/web içine koy.
#
# Windows yolları: ters bölü (\) yerine EĞİK ÇİZGİ (/) kullan. Node ikisini de
# kabul eder, eğik çizgi kaçış (escape) sorunu yaratmaz.

# --- ZORUNLU ---------------------------------------------------------------
# Görsellerin ve ikonların YAZILACAĞI dizin = cdn.mailmyra.com'un docroot'u.
# Plesk > Websites & Domains > cdn.mailmyra.com > Hosting Settings >
# Document root altındaki yolu birebir kullan.
CDN_WRITE_PATH=C:/Inetpub/vhosts/mailmyra.com/cdn.mailmyra.com

# Üretilen imzalarda görünecek genel URL kökü. Sondaki eğik çizgi OLMAZ.
CDN_PUBLIC_URL=https://cdn.mailmyra.com

# --- İŞ MODELİ -------------------------------------------------------------
# Export kapısı. YALNIZCA 'false' kapıyı açar; başka her değer (ve dosyada
# hiç bulunmaması) export'u kilitler ve /login'e yönlendirir.
# /login şu an placeholder olduğu için test aşamasında false kalmalı.
EXPORT_REQUIRES_AUTH=false

# --- İSTEĞE BAĞLI (yazılmazsa parantezdeki varsayılan geçerli) -------------
UPLOAD_RATE_LIMIT_PER_HOUR=20   # (20)  IP başına saatlik görsel yükleme
ICON_RATE_LIMIT_PER_HOUR=60     # (60)  IP başına saatlik ikon üretim isteği
CDN_DISK_QUOTA_MB=5120          # (5120) CDN dizini için disk tavanı
ICON_COLOR_CAP=256              # (256) en fazla kaç marka rengi (outline+mono çifti)
ORPHAN_TTL_DAYS=7               # (7)   cleanup-orphans için yaş eşiği

# --- YAZMA! ----------------------------------------------------------------
# PORT   : iisnode bunu named pipe olarak KENDİSİ verir; elle yazma.
# NODE_ENV: web.config içinde node_env="production" ile ayarlanıyor.
