// Faz 1 veri modeli — docs/superpowers/specs/2026-08-08-backend-and-app-design.md §3
//
// Şema uygulamanın içinde duruyor çünkü migration Plesk panelinden, deploy
// edilmiş uygulamanın kökünden koşuyor: `prisma migrate deploy`.
//
// MariaDB 11.8 notları (ölçüldü, varsayılmadı):
//   · `Json` → LONGTEXT + CHECK(json_valid(...)); motor kendisi ekliyor
//   · kısmi indeks yok → pasif gönderici silinmez, yeniden aktifleştirilir
//   · collation veritabanı düzeyinde utf8mb4_unicode_ci olarak pinli

generator client {
  provider = "prisma-client-js"
}

// Prisma 7'de bağlantı adresleri şemadan çıktı; `prisma.config.ts`'te.
datasource db {
  provider = "mysql"
}

// ─── Kimlik ve oturum ────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  /// Küçük harfe normalize edilerek yazılır. Collation harf duyarsız olduğu
  /// için normalizasyon unutulsa bile mükerrer hesap açılamaz.
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @db.VarChar(255)
  emailVerifiedAt DateTime?
  /// Kullanıcı avatarı (CDN URL, /api/account/avatar yazar) — imza
  /// görsellerinden bağımsız, panel arayüzü için (profil/navbar/üyeler).
  avatarUrl       String?   @db.VarChar(500)
  /// Voldi personeli mi. `Membership.role`dan BAĞIMSIZ bir eksen: `Role`
  /// "bu kişi bir org İÇİNDE ne yapabilir" sorusunu cevaplıyor, bu bayrak
  /// "bu kişi platform personeli mi" sorusunu. Enum'a beşinci değer eklemek
  /// üye listelerini ve rol açılırlarını kirletirdi; üstelik personelin
  /// görünmesi için müşterinin org'una Membership satırı gerekirdi.
  /// Elle açılır (SQL) — personel yaratma ekranı YOK.
  isStaff         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?

  sessions          Session[]
  emailTokens       EmailToken[]
  memberships       Membership[]
  legalAcceptances  LegalAcceptance[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  activityEvents    ActivityEvent[]
  staffAccesses     StaffAccess[]
  adminActions      AdminAction[]
  approvalRequests  ApprovalRequest[]        @relation("ApprovalRequester")
  approvalDecisions ApprovalDecision[]       @relation("ApprovalDecider")
  kvkkOwned         KvkkRequest[]            @relation("KvkkOwner")
  reportSchedules   ReportSchedule[]         @relation("ReportScheduleCreator")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  /// Çerezde opak token durur, burada yalnız SHA-256'sı. Veritabanı sızarsa
  /// oturumlar ele geçirilemez.
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?  @db.VarChar(512)
  ip         String?  @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// Süresi geçmiş oturumları toplayan iş bu indeksi kullanır.
  @@index([expiresAt])
}

enum EmailTokenType {
  verify
  reset
  invite
  email_change
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  /// Yalnız email_change: bekleyen yeni adres token'da durur, kullanıcıda
  /// değil — onaylanmamış adres hesabın hiçbir yerine sızmaz.
  newEmail  String?        @db.VarChar(255)
  tokenHash String         @unique @db.Char(64)
  expiresAt DateTime
  /// Tek kullanımlık: dolduğu an token ölür.
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// ─── Organizasyon, üyelik, koltuk ────────────────────────────────────────

enum EntitlementState {
  trial
  active
  past_due
  cancelled
}

model Organization {
  id String @id @default(cuid())

  name String @db.VarChar(255)

  /// Ajans ağacı (Faz 4). Fatura üst org'da durur, koltuk sayımı ağacı gezer.
  /// `Restrict`: çocuğu olan org silinemez — sessizce müşteri kaybetmeyelim.
  parentOrgId String?

  /// Satın alınmış kapasite. Dönem içinde düşmez (iade yok).
  entitledSeats Int @default(1)

  /// Grandfather için: müşteri hangi fiyat listesinde kaydolduysa o kalır.
  /// Kademe olmadığı için versiyonlanacak ayrı tablo yok, string yetiyor.
  priceVersion String @default("2026-08-07-usd-1-year") @db.VarChar(64)

  entitlementState EntitlementState @default(trial)
  trialEndsAt      DateTime?
  createdAt        DateTime         @default(now())

  parent   Organization?  @relation("OrgTree", fields: [parentOrgId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children Organization[] @relation("OrgTree")

  memberships      Membership[]
  invitations      Invitation[]
  senderIdentities SenderIdentity[]
  signatures       Signature[]
  assets           Asset[]
  legalAcceptances LegalAcceptance[]
  brandSetting     BrandSetting?
  notifications    Notification[]
  invoices         Invoice[]
  activityEvents   ActivityEvent[]

  @@index([parentOrgId])
}

enum Role {
  owner
  admin
  editor
  viewer
}

model Membership {
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId])
}

/// Koltuğu tüketen varlık. İmza değil, **gönderici kimliği** — bir kişinin üç
/// imzası bir koltuk yer.
model SenderIdentity {
  id          String  @id @default(cuid())
  orgId       String
  displayName String  @db.VarChar(255)
  email       String  @db.VarChar(255)
  jobTitle    String? @db.VarChar(255)
  department  String? @db.VarChar(255)

  /// null → taslak, bedava. Dolu ve `deactivatedAt` boş → aktif, koltuk yer.
  publishedAt   DateTime?
  /// Dolu → pasif, koltuk serbest. Kimlik **silinmez**: kısmi indeks olmadığı
  /// için mükerrerliği `@@unique([orgId, email])` engelliyor ve aynı adres
  /// yeniden eklenecekse bu satır yeniden aktifleştiriliyor.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())

  /// Bu göndericinin imzası en son ne zaman dışa aktarıldı (karar 2026-08-15,
  /// dış denetim: "Exported durumu ancak GERÇEK bir export olayı
  /// kaydediliyorsa kullanılmalı"). Denormalize tek alan: aynı bilgiyi
  /// günlükten türetmek gönderici başına satır yazmayı gerektirir ve 50
  /// kişilik bir zip'te günlüğü okunmaz hale getirirdi. Günlükte export
  /// yine bir olay olarak (`export.zip`) duruyor — bu yalnız "en son".
  lastExportedAt DateTime?

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signatures Signature[]

  @@unique([orgId, email])
  /// Koltuk sayımının tek sorgusu bu indeksten okur.
  @@index([orgId, publishedAt, deactivatedAt])
}

/// Henüz hesabı olmayan birini de davet edebilmek için `EmailToken`dan ayrı:
/// o tablo bir `userId` ister, davetin muhatabının ise kullanıcısı olmayabilir.
/// Kabulde `acceptedAt` dolar; kayıt silinmez — kim, ne zaman, hangi rolle
/// katıldı sorusunun cevabı burada durur.
model Invitation {
  id         String    @id @default(cuid())
  orgId      String
  email      String    @db.VarChar(255)
  role       Role
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Aynı adrese aynı org'dan tek bekleyen davet — yenisi eskisini değiştirir.
  @@unique([orgId, email])
  @@index([expiresAt])
}

// ─── İçerik ──────────────────────────────────────────────────────────────

model Signature {
  id    String @id @default(cuid())
  orgId String

  /// Atanmamış imza taslak olarak yaşayabilir. Gönderici silinirse
  /// `SetNull` — müşterinin emeği göndericiyle birlikte gitmez.
  senderIdentityId String?

  templateId String @default("classic-horizontal") @db.VarChar(64)

  /// renderer'ın `SignatureData` tipi. MariaDB'de LONGTEXT + json_valid()
  /// CHECK olarak iner; bütün belge olarak okunup yazılır, içine indeks
  /// atılmaz.
  data Json

  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sender SenderIdentity? @relation(fields: [senderIdentityId], references: [id], onDelete: SetNull)

  @@index([orgId, updatedAt])
  @@index([senderIdentityId])
}

/// Org geneli marka belgesi (spec §3). Signature.data emsali: bütün belge
/// olarak okunup yazılan JSON; içine indeks atılmaz.
model BrandSetting {
  id        String   @id @default(cuid())
  orgId     String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum AssetKind {
  avatar
  logo
  handSignature
}

/// CDN'deki görselin kaydı. Üretilen URL asla değişmez (2 numaralı mimari
/// kural), bu tablo yalnız yaşam döngüsü ve KVKK silme talebi için var.
model Asset {
  id        String    @id @default(cuid())
  orgId     String?
  filename  String    @unique @db.VarChar(255)
  sha256    String    @db.Char(64)
  kind      AssetKind
  bytes     Int
  createdAt DateTime  @default(now())

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([sha256])
}

// ─── Hukuk ve güvenlik ───────────────────────────────────────────────────

enum LegalDocType {
  terms
  privacy
  dpa
}

/// Bir *rıza* değil, **kabul kanıtı**: kim, hangi belge, hangi sürüm, ne
/// zaman, hangi IP. Hesap silinse de kayıt durur (`SetNull`) — yoksa "kabul
/// etti" iddiasını ispatlayacak hiçbir şey kalmaz.
model LegalAcceptance {
  id         String       @id @default(cuid())
  userId     String?
  orgId      String?
  docType    LegalDocType
  version    String       @db.VarChar(32)
  acceptedAt DateTime     @default(now())
  ip         String       @db.VarChar(45)

  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orgId])
}

/// Auth uçlarının rate limit sayacı — bellekte değil burada.
/// `web.config` süreç sayısını sabitlemiyor; iisnode birden fazla süreç
/// açarsa bellek içi sayaç bölünür ve limit anlamsızlaşır.
model AuthAttempt {
  /// `ip:1.2.3.4` ya da `email:ali@voldi.net`
  key         String   @db.VarChar(255)
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  /// Eski pencereleri temizleyen iş bu indeksten okur.
  @@index([windowStart])
}

/// Panel bildirimi — navbar zilinin kaynağı (karar 2026-08-13: türetilmiş
/// besleme değil kalıcı tablo). Alıcı kullanıcıdır; org bağlamı satırı
/// yorumlamak için. Üreticiler hata YUTAR — bildirim yazılamadı diye
/// publish/davet akışı devrilmez (koltuk uyarı maili emsali).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  orgId     String?
  /// 'sender_published' | 'seat_warning' | 'invitation_accepted' — kod
  /// tarafında NotificationType birliği; kolonda enum değil varchar,
  /// yeni tip migration istemesin diye.
  type      String    @db.VarChar(40)
  /// Tipe özgü küçük yük (adlar, sayılar). MariaDB'de LONGTEXT'tir,
  /// içine indeks atılmaz — sorgular userId/readAt üzerinden.
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Zil rozeti: okunmamış sayısı bu indeksten.
  @@index([userId, readAt])
  /// Liste: kullanıcının son bildirimleri.
  @@index([userId, createdAt])
}

/// Bildirim tercihi — kullanıcı × olay tipi (karar 2026-08-15, dış denetim
/// bulgusu: Notifications sekmesi yalnız geçmişi açıklıyordu).
/// SATIR YOKSA VARSAYILAN AÇIK (opt-out): yeni olay tipi eklendiğinde eski
/// kullanıcılar sessizce sağır kalmasın. Tabloya yalnız kullanıcı bir şeyi
/// kapattığında (ya da geri açtığında) satır düşer.
model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  /// `NotificationType` ile aynı birlik — kolonda enum değil varchar,
  /// yeni tip migration istemesin diye (Notification.type emsali).
  type   String  @db.VarChar(40)
  /// Zil ve bildirim merkezi.
  inApp  Boolean @default(true)
  /// E-posta kanalı. Bugün yalnız `seat_warning` gerçekten mail üretiyor;
  /// diğer tiplerde ayar ileriye dönük durur (arayüz bunu açıkça söyler).
  email  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/// Denetim günlüğü — "kim neyi ne zaman yaptı" (karar 2026-08-15, dış
/// denetim P2). Bildirimden AYRI tablo: bildirim KİŞİYE gider, okunur ve
/// tercihle susturulabilir; günlük ORG'a aittir, susturulamaz ve kalıcıdır.
/// Yazıcı hata YUTAR — günlük yazılamadı diye publish/export devrilmez.
model ActivityEvent {
  id          String   @id @default(cuid())
  orgId       String
  /// Eylemi yapan. Kullanıcı hesabını silerse satır kalır, aktör düşer
  /// (`SetNull`) — denetim izi kişinin gidişiyle kaybolmaz.
  actorUserId String?
  /// 'sender.published' | 'export.zip' | 'brand.saved' … — kod tarafında
  /// `ActivityType` birliği; kolonda varchar (Notification.type emsali).
  type        String   @db.VarChar(48)
  /// Olayın öznesi. FK YOK ve olmayacak: hedef silindiğinde günlük satırı
  /// da silinseydi "X silindi" kaydı silinmenin kendisiyle kaybolurdu.
  targetType  String?  @db.VarChar(24)
  targetId    String?  @db.VarChar(64)
  /// Ekrana basılan insan-okur ayrıntı (ad, sayı, dosya adedi). Hedef
  /// silinse bile satır anlamlı kalsın diye değerler KOPYALANIR.
  payload     Json
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Günlük listesi (yeni → eski).
  @@index([orgId, createdAt])
  /// Tip filtresi aynı listede.
  @@index([orgId, type, createdAt])
  /// "Bu göndericinin son export'u" — sender detayındaki satır.
  @@index([targetId, createdAt])
}

/// Manuel kesilen fatura KAYDI (karar 2026-08-15, Hüseyin: fatura
/// görüntülenip yazdırılabilsin). Otomatik abonelik YAZILMAZ (CLAUDE.md
/// kilitli karar) — satırı ekip elle açar (şimdilik SQL), panel yalnız
/// listeler, gösterir, yazdırır. Kesim arayüzü bilinçli olarak YOK.
/// Fatura ajans ağacında kök (billing) org'a kesilir.
model Invoice {
  id    String @id @default(cuid())
  orgId String

  /// İnsan-okur numara (ör. MM-2026-0001) — elle verilir, global benzersiz.
  number String @unique @db.VarChar(32)

  issuedAt DateTime
  dueAt    DateTime?

  /// Tutarlar cent — kayan noktalı para yok. `amountCents` gerçeğin
  /// kaynağıdır; seats×unit'ten saparsa ekran farkı "Adjustment" gösterir.
  seats       Int
  unitCents   Int    @default(100)
  amountCents Int
  currency    String @default("USD") @db.VarChar(8)

  /// 'due' | 'paid' | 'void' — kod tarafında InvoiceStatus birliği;
  /// kolonda enum değil varchar (Notification.type emsali).
  status String @default("due") @db.VarChar(16)

  /// Faturaya basılan serbest not (havale bilgisi, dönem açıklaması).
  note String? @db.VarChar(500)

  /// Ödeme kaydı (2026-08-19). `status='paid'` tek başına muhasebe kaydı
  /// değil: ne zaman, nasıl, hangi dekontla ödendiği burada durur. Kısmi
  /// ödeme BİLİNÇLİ kapsam dışı — gerekirse ayrı tablo açılır, bu üç alan
  /// tek seferde ödenen manuel fatura için yeter.
  paidAt           DateTime?
  /// 'bank_transfer' | 'cash' | 'other' — kod tarafında birlik.
  paymentMethod    String?   @db.VarChar(24)
  /// Banka dekont/havale referansı.
  paymentReference String?   @db.VarChar(128)

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, issuedAt])
}

// ─── Platform personeli erişim günlüğü ───────────────────────────────────

/**
 * Voldi personeli bir MÜŞTERİNİN verisine baktığında buraya satır düşer.
 * Neden `ActivityEvent` değil: o tablo müşterinin kendi aktivite akışı ve
 * ekranda ona gösteriliyor. Destek için yapılan her bakışı oraya yazmak hem
 * gürültü olurdu hem müşteriyi tedirgin ederdi. Personelin YAZMA işlemleri
 * (deneme uzatma, koltuk düzeltme) yine ActivityEvent'e gider — onları
 * müşteri görmeli.
 * İki alan bilerek KOPYA tutuluyor (`staffEmail`, `orgName`): satır, işaret
 * ettiği kayıtlar silinse bile tek başına anlamlı kalmalı.
 */
model StaffAccess {
  id String @id @default(cuid())

  /// Bakan personel. Hesap silinirse satır KALIR, aktör düşer (`SetNull`) —
  /// ActivityEvent.actorUserId ile aynı gerekçe: erişim kaydı kişinin
  /// gidişiyle kaybolmaz. Kim olduğu `staffEmail`de kopya duruyor.
  staffUserId String?
  /// Erişim anındaki e-posta. Kopyalanır ki hesap silinse de "kim baktı"
  /// sorusunun cevabı kalsın.
  staffEmail  String  @db.VarChar(255)

  /// Bakılan müşteri org'u. **FK YOK ve olmayacak**: `Cascade` olsaydı
  /// müşteri silindiğinde "personel şu tarihte bu müşterinin verisine baktı"
  /// kaydı da silinirdi — erişim günlüğünün varlık sebebi tam olarak bu
  /// kaydın kalması. (ActivityEvent.targetId aynı gerekçeyle FK'sız.)
  orgId   String @db.VarChar(64)
  orgName String @db.VarChar(255)

  /// 'org' | 'senders' | 'signatures' | 'signature' — ne görüntülendi.
  /// Kod tarafında birlik, kolonda varchar (Notification.type emsali).
  scope    String  @db.VarChar(24)
  /// Tekil bir kayda bakıldıysa onun kimliği.
  targetId String? @db.VarChar(64)

  /// Erişimin geldiği yer — Session.ip/userAgent ile aynı ölçüler.
  ip        String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  createdAt DateTime @default(now())

  staff User? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  /// "Bu müşteriye kim, ne zaman baktı" — KVKK talebi geldiğinde sorulacak soru.
  @@index([orgId, createdAt])
  /// "Bu personel neye baktı" — iç denetim.
  @@index([staffUserId, createdAt])
}

/**
 * Personelin YAZMA işlemlerinin değişmez iç kaydı. `ActivityEvent`ten ayrı:
 * o müşteriye gösterilen akış, bu Voldi'nin kendi denetim defteri — sebep
 * metni ve before/after anlık görüntüleri müşteriye sızmamalı.
 * Satırlar YALNIZ eklenir; güncelleme ve silme yolu bilerek yok. İş
 * değişikliğiyle AYNI transaction'da yazılır — denetim kaydı yazılamazsa
 * değişiklik geri alınır (best-effort denetim, denetim değildir).
 */
model AdminAction {
  id String @id @default(cuid())

  /// Yapan personel. Hesap silinirse satır kalır (`SetNull`), kimliği
  /// `staffEmail` kopyasında yaşar — StaffAccess ile aynı desen.
  staffUserId String?
  staffEmail  String  @db.VarChar(255)

  /// Hedef org. FK YOK: müşteri silinse de "ona ne yapılmıştı" kaydı kalır.
  orgId   String @db.VarChar(64)
  orgName String @db.VarChar(255)

  /// 'entitlement.set' | 'invoice.created' | 'invoice.status_set' — kod
  /// tarafında birlik, kolonda varchar (Notification.type emsali).
  action   String  @db.VarChar(48)
  targetId String? @db.VarChar(64)

  /// Değişiklik öncesi/sonrası anlık görüntü — "neydi, ne oldu" sorusunun
  /// tek cevabı. İnsan-okur değerler KOPYALANIR (ActivityEvent sözleşmesi).
  before Json
  after  Json

  /// Zorunlu gerekçe — sessiz düğme değişikliği yok. Üç ay sonra "neden 5
  /// koltuk verdim" sorusunun cevabı.
  reason String @db.VarChar(500)

  ip        String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  createdAt DateTime @default(now())

  staff User? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([staffUserId, createdAt])
}

// ─── Onay akışı (governance) ─────────────────────────────────────────────

/**
 * Yüksek riskli yönetim değişikliği için karar kaydı. UI onay/ret düğmeleri
 * BİLİNÇLİ olarak kapalı (devir sözleşmesi §7): yetkilendirme + kalıcılık +
 * denetim + hata yolu birlikte gelene kadar yalnız kayıt ve okuma var.
 * Hiçbir satır silinmez; yaşam döngüsü `status` ile yürür ve her adım
 * `ApprovalEvent`e düşer. FK'ler `Restrict`: kayıt zinciri koparılamaz.
 */
model ApprovalRequest {
  id String @id @default(cuid())

  title         String @db.VarChar(160)
  /// 'entitlement' | 'billing' | 'security' | 'platform' — kod tarafında birlik.
  domain        String @db.VarChar(32)
  /// 'medium' | 'high' | 'critical'
  riskLevel     String @db.VarChar(16)
  policyVersion String @db.VarChar(32)

  /// Hedef müşteri (varsa). Ad KOPYALANIR — org silinse de kayıt anlamlı.
  orgId      String? @db.VarChar(64)
  orgName    String? @db.VarChar(255)
  targetType String? @db.VarChar(24)
  targetId   String? @db.VarChar(64)

  requestedById    String?
  requestedByEmail String  @db.VarChar(255)
  reason           String  @db.VarChar(500)

  requiredApprovals Int @default(1)

  /// 'pending' | 'approved' | 'rejected' | 'cancelled'
  status         String    @default("pending") @db.VarChar(16)
  decidedAt      DateTime?
  decidedByEmail String?   @db.VarChar(255)
  decisionReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())

  requestedBy User?              @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decisions   ApprovalDecision[]
  events      ApprovalEvent[]

  @@index([status, createdAt])
}

/// Tekil onaycı kararı — `requiredApprovals` sayacı bunlardan sayılır.
model ApprovalDecision {
  id        String @id @default(cuid())
  requestId String

  /// 'approve' | 'reject'
  decision       String  @db.VarChar(16)
  decidedById    String?
  decidedByEmail String  @db.VarChar(255)
  reason         String  @db.VarChar(500)

  createdAt DateTime @default(now())

  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  decidedBy User?           @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  /// Bir onaycı bir talebe tek karar yazar.
  @@unique([requestId, decidedByEmail])
}

/// Değişmez yaşam döngüsü defteri — yalnız eklenir.
model ApprovalEvent {
  id        String @id @default(cuid())
  requestId String

  /// 'created' | 'decision_recorded' | 'approved' | 'rejected' | 'cancelled'
  type       String @db.VarChar(32)
  actorEmail String @db.VarChar(255)
  payload    Json

  createdAt DateTime @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

// ─── KVKK veri öznesi talepleri ──────────────────────────────────────────

/**
 * Yasal veri öznesi talebi. `statutoryDueAt` KVKK'nın 30 günlük yasal
 * süresi — SLA süsü değil, kanuni tarih. Satır silinmez; kapanış
 * `status='completed'` + `respondedAt` ile olur ve her adım `KvkkEvent`e
 * düşer. Kanıtlar `KvkkEvidence`te birikir.
 */
model KvkkRequest {
  id String @id @default(cuid())

  /// İnsan-okur referans (KVKK-2026-0001) — elle verilir, benzersiz.
  reference String @unique @db.VarChar(32)

  /// Talep sahibinin e-postası — işin kendisi bu kişisel veri; bu tabloyu
  /// LİSTELEMEK bile StaffAccess'e loglanır (repo katmanı yapar).
  subjectEmail String @db.VarChar(255)

  /// İlgili müşteri (varsa). Ad kopyalanır.
  orgId   String? @db.VarChar(64)
  orgName String  @default("") @db.VarChar(255)

  /// 'access' | 'erasure' | 'correction' | 'portability'
  type   String @db.VarChar(16)
  /// 'intake' | 'identity_check' | 'in_progress' | 'legal_review' | 'completed'
  status String @default("intake") @db.VarChar(24)

  receivedAt  DateTime
  receivedVia String?  @db.VarChar(32)

  statutoryDueAt DateTime

  identityVerifiedAt DateTime?
  identityMethod     String?   @db.VarChar(48)

  ownerId    String?
  ownerEmail String? @db.VarChar(255)

  respondedAt     DateTime?
  responseSummary String?   @db.VarChar(1000)

  createdAt DateTime @default(now())

  owner    User?          @relation("KvkkOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  evidence KvkkEvidence[]
  events   KvkkEvent[]

  @@index([status, statutoryDueAt])
}

/// Talep için toplanan kanıt/işlem çıktısı işaretçileri.
model KvkkEvidence {
  id        String @id @default(cuid())
  requestId String

  label        String @db.VarChar(160)
  /// Dosya yolu / dahili not — kanıtın kendisi değil, işaretçisi.
  location     String @db.VarChar(500)
  addedByEmail String @db.VarChar(255)

  createdAt DateTime @default(now())

  request KvkkRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

/// Değişmez yaşam döngüsü defteri — yalnız eklenir.
model KvkkEvent {
  id        String @id @default(cuid())
  requestId String

  /// 'received' | 'identity_verified' | 'owner_assigned' | 'status_changed'
  /// | 'evidence_added' | 'responded' | 'completed'
  type       String @db.VarChar(32)
  actorEmail String @db.VarChar(255)
  payload    Json

  createdAt DateTime @default(now())

  request KvkkRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

// ─── Zamanlanmış raporlar ────────────────────────────────────────────────

/**
 * Rapor zamanlaması — `reportId` `reporting-model.ts`teki REPORT_LIBRARY
 * anahtarına işaret eder (formül/kaynak/tazelik sözleşmesi orada, kod
 * denetiminde). ÇALIŞTIRICI YOK: `ReportExecution`/`ReportDelivery`
 * defterleri gerçek bir koşu olana kadar BOŞ kalır — sahte geçmiş
 * üretilmez (devir sözleşmesi).
 */
model ReportSchedule {
  id String @id @default(cuid())

  reportId String @db.VarChar(48)
  /// 'daily' | 'weekly' | 'monthly'
  cadence  String @db.VarChar(16)
  timezone String @default("Europe/Istanbul") @db.VarChar(64)
  /// 'csv' | 'pdf' | 'digest'
  format   String @db.VarChar(16)

  /// 'active' | 'paused'
  status    String    @default("active") @db.VarChar(16)
  nextRunAt DateTime?

  ownerEmail     String  @db.VarChar(255)
  createdById    String?
  createdByEmail String  @db.VarChar(255)

  createdAt DateTime @default(now())

  createdBy  User?             @relation("ReportScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients ReportRecipient[]
  executions ReportExecution[]

  @@index([status, nextRunAt])
}

/// Alıcı listesi — yapılandırmadır, zamanlama silinirse birlikte gider.
model ReportRecipient {
  id         String @id @default(cuid())
  scheduleId String
  email      String @db.VarChar(255)

  schedule ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, email])
}

/// Değişmez koşu defteri — çalıştırıcı yazana kadar boş.
model ReportExecution {
  id         String @id @default(cuid())
  scheduleId String

  startedAt  DateTime
  finishedAt DateTime?
  /// 'running' | 'success' | 'failed'
  status     String    @db.VarChar(16)
  error      String?   @db.VarChar(500)
  rowCount   Int?

  schedule   ReportSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  deliveries ReportDelivery[]

  @@index([scheduleId, startedAt])
}

/// Değişmez teslim defteri — koşu başına alıcı sonucu.
model ReportDelivery {
  id          String @id @default(cuid())
  executionId String

  recipientEmail String  @db.VarChar(255)
  /// 'sent' | 'failed'
  status         String  @db.VarChar(16)
  detail         String? @db.VarChar(500)

  createdAt DateTime @default(now())

  execution ReportExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@index([executionId])
}

// ─── Growth: lead defteri ────────────────────────────────────────────────

/**
 * Elle yürüyen satış hattı (2026-08-21, Hüseyin'in YAPILMAYACAKLAR
 * istisnasıyla). Otomatik kaynak YOK — pazarlama sitesinin formu posta
 * atıyor, DB'ye yazmıyor; satırlar şimdilik SQL/panelle açılır. Rıza
 * gerektiren izleme eklenmez.
 */
model Lead {
  id String @id @default(cuid())

  company  String @db.VarChar(160)
  contact  String @db.VarChar(255)
  /// 'referral' | 'inbound' | 'outreach' | 'event' — serbest ama kısa.
  source   String @db.VarChar(48)
  seats    Int    @default(1)
  /// 'new' | 'qualified' | 'scheduled' | 'won'
  stage    String @default("new") @db.VarChar(16)
  nextStep String @default("") @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, createdAt])
}

// ─── Support: vaka defteri ───────────────────────────────────────────────

/**
 * Destek vakaları. `requesterEmail` müşteri kişisel verisi — bu tabloyu
 * LİSTELEMEK StaffAccess'e loglanır (KVKK defteri emsali). Satır silinmez;
 * kapanış `status='resolved'`.
 */
model SupportCase {
  id String @id @default(cuid())

  reference String @unique @db.VarChar(32)
  subject   String @db.VarChar(200)

  orgId   String? @db.VarChar(64)
  orgName String  @default("") @db.VarChar(255)

  requesterEmail String @db.VarChar(255)
  /// 'email' | 'form' | 'staff'
  channel        String @db.VarChar(16)
  /// 'billing' | 'builder' | 'export' | 'access' | 'account'
  category       String @db.VarChar(24)
  /// 'urgent' | 'high' | 'normal' | 'low'
  priority       String @db.VarChar(16)
  /// 'open' | 'waiting_customer' | 'escalated' | 'resolved'
  status         String @default("open") @db.VarChar(24)

  ownerEmail String?  @db.VarChar(255)
  slaDueAt   DateTime
  summary    String   @default("") @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, slaDueAt])
}

// ─── Platform telemetrisi ────────────────────────────────────────────────

/**
 * Posta teslim defteri — `getMailer` her gönderimde yazar (en-iyi-çaba:
 * defter yazılamıyorsa POSTA YİNE GİDER, posta kralın kendisi).
 * `state='delivered'` SMTP rölesinin KABUL ETTİĞİ anlamına gelir — uç
 * teslim garantisi değil; DSN takibi yok. Alıcının yalnız ALAN ADI tutulur
 * (privacy by default) — tam adres panelde gösterilmez.
 */
model MailDelivery {
  id String @id @default(cuid())

  /// 'verification' | 'invitation' | 'notification' | 'support' | 'report'
  kind            String  @db.VarChar(16)
  provider        String  @db.VarChar(64)
  recipientDomain String  @db.VarChar(255)
  /// 'delivered' (röle kabul etti) | 'failed'
  state           String  @db.VarChar(16)
  attempts        Int     @default(1)
  error           String? @db.VarChar(300)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// İş koşuları — şimdilik tek gerçek iş: cleanup-orphans (elle koşulur).
model JobRun {
  id String @id @default(cuid())

  name       String  @db.VarChar(64)
  queue      String  @default("manual") @db.VarChar(32)
  /// 'running' | 'complete' | 'failed'
  state      String  @db.VarChar(16)
  attempts   Int     @default(1)
  durationMs Int?
  error      String? @db.VarChar(300)

  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([name, scheduledAt])
}

/**
 * Hata yakalama — Next `instrumentation.onRequestError` yazar. Grup =
 * parmak izi (ad+mesaj); olaylar ayrı tabloda birikir ki "kaç kez, kaç
 * org" gerçek sayı olsun. Satır silinmez; `state` ile yönetilir.
 */
model ErrorGroup {
  id String @id @default(cuid())

  fingerprint String @unique @db.VarChar(64)
  title       String @db.VarChar(200)
  surface     String @db.VarChar(100)
  /// 'critical' | 'error' | 'warning'
  severity    String @default("error") @db.VarChar(16)
  /// 'open' | 'investigating' | 'resolved'
  state       String @default("open") @db.VarChar(16)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  events ErrorEvent[]

  @@index([state, lastSeenAt])
}

model ErrorEvent {
  id          String  @id @default(cuid())
  fingerprint String  @db.VarChar(64)
  orgId       String? @db.VarChar(64)

  createdAt DateTime @default(now())

  group ErrorGroup @relation(fields: [fingerprint], references: [fingerprint], onDelete: Restrict)

  @@index([fingerprint, createdAt])
}
