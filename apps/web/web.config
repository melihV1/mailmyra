<?xml version="1.0" encoding="utf-8"?>
<!-- IIS + iisnode yapılandırması (Plesk Windows deploy). Yerelde etkisizdir. -->
<configuration>
  <system.webServer>
    <handlers>
      <!-- hello.js: iisnode'un Next'ten BAĞIMSIZ çalışıp çalışmadığını
           sınayan teşhis dosyası. https://<site>/hello.js adresini aç. -->
      <add name="iisnode-hello" path="hello.js" verb="*" modules="iisnode" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- hello.js kendi handler'ına gitsin, uygulamaya yönlendirilmesin. -->
        <rule name="hello-passthrough" stopProcessing="true">
          <match url="^hello\.js$" />
          <action type="None" />
        </rule>

        <!-- Her istek Node'a: statikleri de Next servis eder (public/ dahil).
             CDN ayrı vhost olduğu için burada statik istisnasına gerek yok. -->
        <rule name="mailmyra-app">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
        <!-- 6MB: 5MB dosya limiti + multipart çerçeveleme/boundary payı
             (upload route kendi içinde zaten 5MB'ı uygular). -->
        <requestLimits maxAllowedContentLength="6291456" />
      </requestFiltering>
    </security>

    <!-- nodeProcessCommandLine BİLEREK YOK.
         Plesk, Node sürümlerini kendi yönetir (panelde "Node.js Sürümü"
         alanı) ve node.exe'yi kendi dizinine kurar — bu yol
         C:\Program Files\nodejs\node.exe OLMAYABİLİR. Burada elle bir yol
         yazmak, Plesk'in doğru bildiği yolu yanlışıyla ezer ve süreç hiç
         başlamaz (belirti: 500 + iisnode log klasörünün hiç oluşmaması).
         Yol yazılmazsa iisnode sunucu düzeyindeki yapılandırmayı kullanır.

         NOT: Eğer elle bir yol yazmak GEREKİRSE ve yol boşluk içeriyorsa
         MUTLAKA tırnak içine al:
           nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
         Tırnaksız yazılırsa iisnode komutu boşluktan böler.

         devErrorsEnabled: gerçek hata metnini TARAYICIDA gösterir — log
         dosyasına erişemediğimiz panel-only ortamda teşhis için şart.
         Sorun çözülünce "false" yapılmalı (hata detayı sızdırmamak için).

         debuggingEnabled BİLEREK KAPALI: node-inspector gerektirir ve kendisi
         ayrı bir 500 kaynağı olabilir; hatayı görmek için devErrorsEnabled
         yeterlidir. -->
    <iisnode
      node_env="production"
      watchedFiles="web.config;server.js"
      flushResponse="true"
      maxNamedPipeConnectionRetry="24"
      namedPipeConnectionRetryDelay="250"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="true"
      debuggingEnabled="false" />

    <!-- Next'in kendi 404/500 sayfaları IIS tarafından ezilmesin; iisnode'un
         hata metni de bu sayede tarayıcıya ulaşır. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
