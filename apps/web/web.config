<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode (Plesk Windows). Yerelde etkisizdir.

  ⚠️ BU DOSYA REFERANSTIR, CANLI KOPYA DEĞİL. Plesk sunucudaki web.config'i
  kendiliğinden yeniden üretiyor (`<tracing>` ve `<system.web>` blokları
  2026 içinde böyle eklendi, bizim `httpErrors` açıklama yorumumuz Plesk'in
  bir üretiminde silindi) ve `scripts/deploy.js` bu dosyayı HİÇ yüklemiyor —
  yani buradaki değişiklik tek başına sunucuya asla ulaşmaz. Repodaki kopya
  şu an canlıda gerçekten ne olduğunun bilinen en güncel kaydı (2026-09-14
  itibarıyla, aşağıdaki bloklar dahil) ve yeni bir satır eklerken (ör.
  `<iisnode promoteServerVars>`) editini CANLI dosyaya ELLE (Plesk dosya
  yöneticisi / RDP) uygulaman gerekir — repo commit'i yalnız belgeler.

  BU DOSYA BİLEREK MİNİMAL — büyütmeden önce oku:

  Plesk paylaşımlı hostingde `system.webServer` altındaki bazı bölümler
  KİLİTLİDİR (override izni yok). web.config bunlardan birine dokunursa IIS
  yapılandırmayı hiç yükleyemez ve SİTENİN TAMAMI 0 baytlık 500 döner —
  olmayan yollar dahil. Belirti aldatıcıdır: iisnode log klasörü de hiç
  oluşmaz (süreç başlamadığı için), bu yüzden "node çalışmıyor" gibi görünür.
  2026-07-27'de tam olarak bu yaşandı; sebebi aşağıdaki bölümlerdi:

    <security><requestFiltering>   -> kilitli, 500
    <httpErrors>                   -> kilitli, 500
    <iisnode nodeProcessCommandLine=...>  -> Plesk'in kendi Node kurulumunu
                                             (panelde seçili sürüm) ezer

  Kural: buraya YALNIZCA handler + rewrite + (artık) iisnode promoteServerVars
  girer. Yeni bir ayar eklemen gerekirse önce tek başına dene ve siteyi
  kontrol et.

  Node yolu, sürüm ve ortam Plesk tarafından IIS site düzeyinde verilir —
  burada TANIMLANMAZ.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Her istek Next'e; statikleri de Next servis eder.
             `server.js` belge köküne (apps/web) görelidir. -->
        <rule name="mailmyra-app">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- Plesk'in kendiliğinden eklediği blok — biz yazmadık, biz silmiyoruz.
         İçeriği boş (yalnız <clear/>): FRT (Failed Request Tracing) kural
         listesini sıfırlıyor, bir şey AÇMIYOR. Kaldırılırsa bir sonraki
         Plesk-tetikli yeniden üretimde muhtemelen geri gelir. -->
    <tracing>
      <traceFailedRequests>
        <clear />
      </traceFailedRequests>
    </tracing>
    <!-- Gerçek istemci IP'si: IIS'in ölçtüğü REMOTE_ADDR'ı iisnode'un
         `x-iisnode-remote_addr` header'ı olarak Node'a ilettiği ayar.
         Bkz. apps/web/lib/client-ip.ts ve docs/client-ip-never-captured.md —
         önümüzde zincire ekleme yapan bir proxy yok, bu satır olmadan
         gerçek IP hiçbir yoldan uygulamaya ulaşmıyordu (launch'tan beri
         `Session.ip` hep 'local' yazılıyordu). Kural gereği (yukarı bak)
         TEK BAŞINA deploy edilip kök doğrulanmalı, sonra kod gitmeli. -->
    <iisnode promoteServerVars="REMOTE_ADDR" />
    <!-- API'nin 4xx/5xx JSON govdeleri IIS'in kendi hata sayfasiyla
         degistirilmesin. app.mailmyra.com'da CANLIDA dogrulandi (2026-08-10):
         bolum bu subdomain'de kilitli DEGIL, /login saglikli kaldi ve API
         gercek JSON dondurmeye basladi. Ana siteye deploy edilecekse orada
         ayrica test et — 2026-07-27 olayi ana sitedeydi. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
  <!-- Plesk'in kendiliğinden eklediği blok — biz yazmadık, biz silmiyoruz.
       ASP.NET geçici derleme dizinini gösteriyor; bu site Node/iisnode
       çalıştırıyor, ASP.NET derlemesi kullanmıyor — etkisiz ama zararsız. -->
  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\mailmyra.com\tmp" />
  </system.web>
</configuration>
