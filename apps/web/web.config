<?xml version="1.0" encoding="utf-8"?>
<!-- IIS + iisnode yapılandırması (Plesk Windows deploy). Yerelde etkisizdir. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Her istek Node'a: statikleri de Next servis eder (public/ dahil).
             CDN ayrı vhost olduğu için burada statik istisnasına gerek yok. -->
        <rule name="mailmyra-app">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
        <!-- 6MB: 5MB dosya limiti + multipart çerçeveleme payı (upload route
             kendi içinde zaten 5MB'ı uygular; bu IIS'in erken kapısı). -->
        <requestLimits maxAllowedContentLength="6291456" />
      </requestFiltering>
    </security>

    <!-- nodeProcessCommandLine: sunucudaki gerçek node.exe yolu.
         flushResponse: App Router streaming cevaplarının iisnode'da
         tamponlanıp gecikmemesi için. -->
    <iisnode
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      node_env="production"
      watchedFiles="web.config;server.js"
      flushResponse="true"
      maxNamedPipeConnectionRetry="24"
      namedPipeConnectionRetryDelay="250"
      loggingEnabled="true" />

    <!-- Next'in kendi 404/500 sayfaları IIS tarafından ezilmesin. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
