            <main class="mm-auth mm-auth--embedded mm-auth--focused" data-auth-shell>
                <span class="mm-auth__grid" aria-hidden="true"></span>
                <span class="mm-auth__glow mm-auth__glow--blue" aria-hidden="true"></span>
                <span class="mm-auth__glow mm-auth__glow--orange" aria-hidden="true"></span>
                <div class="mm-auth__main">
            <section class="mm-auth__panel" aria-labelledby="mm-login-title">
                <div class="mm-auth__panel-head">
                    <span class="mm-auth__step"><i></i>Workspace access</span>
                    <h2 id="mm-login-title">Welcome back.</h2>
                    <p>Log in to manage signatures, senders and brand controls.</p>
                </div>

                <!-- mm: SSO DÜĞMELERİ GEÇİCİ OLARAK KAPALI (2026-08-18).
                     Üründe Google/Microsoft ile giriş henüz YOK; açık
                     bırakılırsa giriş sayfasının en görünür iki düğmesi
                     hiçbir şey yapmaz. Geri açmak için aşağıdaki iki bloğun
                     yorumunu kaldır — başka değişiklik gerekmez.
                     Yapılacaklar: docs/backlog.md §SSO
                <div class="mm-auth__providers">
                    <a href="#" aria-label="Continue with Google"><img src="assets/img/login/google.svg" alt="">Continue with Google</a>
                    <a href="#" aria-label="Continue with Microsoft"><i class="fa-brands fa-microsoft" aria-hidden="true"></i>Microsoft</a>
                </div>

                <div class="mm-auth__divider"><span>or continue with email</span></div>
                -->

                <form class="mm-auth__form" action="https://app.mailmyra.com/api/auth/login" method="post">
                            <p class="mm-auth__error" data-auth-error hidden role="alert" aria-live="polite"></p>
                    <div class="mm-auth__field">
                        <label for="login-email">Work email</label>
                        <div class="mm-auth__input">
                            <i class="fa-light fa-envelope" aria-hidden="true"></i>
                            <input id="login-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required>
                        </div>
                    </div>

                    <div class="mm-auth__field">
                        <div class="mm-auth__label-row">
                            <label for="login-password">Password</label>
                            <a href="https://app.mailmyra.com/reset-password">Forgot password?</a>
                        </div>
                        <div class="mm-auth__input">
                            <i class="fa-light fa-lock-keyhole" aria-hidden="true"></i>
                            <input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" minlength="6" required>
                            <button class="mm-auth__password-toggle" type="button" aria-label="Show password" aria-pressed="false" data-password-toggle>
                                <svg class="mm-auth__eye mm-auth__eye--show" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                                    <path d="M1.75 9s2.55-4.25 7.25-4.25S16.25 9 16.25 9 13.7 13.25 9 13.25 1.75 9 1.75 9Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round"/>
                                    <circle cx="9" cy="9" r="2.15" stroke="currentColor" stroke-width="1.45"/>
                                </svg>
                                <svg class="mm-auth__eye mm-auth__eye--hide" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                                    <path d="M2 2l14 14M7.25 4.98A7.9 7.9 0 0 1 9 4.75c4.7 0 7.25 4.25 7.25 4.25a12.2 12.2 0 0 1-2.04 2.47M10.75 12.98A7.9 7.9 0 0 1 9 13.25C4.3 13.25 1.75 9 1.75 9a12.2 12.2 0 0 1 2.04-2.47" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- mm: "Beni hatırla" GEÇİCİ OLARAK KAPALI (2026-08-18).
                         Oturum çerezi zaten HER ZAMAN 30 gün (lib/auth/cookie.ts
                         SESSION_TTL_SECONDS); kutu işaretlense de işaretlenmese de
                         hiçbir şey değişmiyordu. Anlamlı hâle getirmek için uçta
                         kısa/uzun oturum ayrımı gerekir — o gelince yorumu kaldır.
                    <label class="mm-auth__remember">
                        <input type="checkbox" name="remember">
                        <span><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                        Keep me signed in on this device
                    </label>
                    -->

                    <button class="mm-btn-solid mm-auth__submit" type="submit">
                        <span class="mm-btn__face">
                            <span class="mm-btn__label"><span>Log in to Mailmyra</span><span aria-hidden="true">Log in to Mailmyra</span></span>
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h9M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </button>
                </form>

                <div class="mm-auth__panel-foot">
                    <div class="mm-auth__assurance">
                        <i class="fa-light fa-shield-check" aria-hidden="true"></i>
                        <span><b>Private by default</b>Your workspace data stays protected.</span>
                    </div>
                    <p class="mm-auth__mobile-register"><span>New to Mailmyra?</span><a href="/register">Create an account <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></p>
                </div>
            </section>

            <div class="mm-auth__status" aria-label="Mailmyra workspace status">
                <span><i></i>Brand locked</span>
                <span>Outlook-safe HTML</span>
                <span>Live inbox previews</span>
            </div>
        
                </div>
            </main>




