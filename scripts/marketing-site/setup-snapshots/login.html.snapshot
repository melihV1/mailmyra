<!doctype html>
<html class="no-js agntix-dark" lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Log in | Mailmyra</title>
    <meta name="description" content="Log in to Mailmyra to manage your email signatures, brand controls and team workspaces.">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Place favicon.ico in the root directory -->
    <link rel="shortcut icon" type="image/x-icon" href="assets/img/favicon/favicon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;family=Phudu:wght@300..900&amp;display=swap">
    <!-- mm: TEK STIL DOSYASI. Onceki 9 ayri dosya + bundle
             (index-it-solution-dark[.subset].min.css) main.css'te birlestirildi;
             artik duzenlenecek tek yer orasi. Bundle dosyalari SILINDI. -->
    <link rel="stylesheet" href="assets/css/main.css?v=mailmyra-0818-login-3">
    <!-- mm: acilis ekrani (GLOW) — lab sayfasiyla paylasildigi icin ayri durdu -->
    <link rel="stylesheet" href="assets/css/mailmyra-preloader-glow.css?v=mailmyra-0803-1">
    <!-- mm: sayfa ilerleme dugmesi (eski go-to-top) -->
    <link rel="stylesheet" href="assets/css/mailmyra-scrollprogress.css?v=mailmyra-0803-1">
    <!-- mm: buyuyen mobil navigasyon -->
    <link rel="stylesheet" href="assets/css/mailmyra-nav.css?v=mailmyra-0803-6">
    <!-- mm: index'in mobil content-visibility <style> blogu BILEREK alinmadi —
             icindeki bolum yukseklikleri index'in kendi bolumlerine ait. -->

</head>

<body class="tp-magic-cursor mm-auth-page">

    <!-- mm: acilis ekrani (GLOW) — start ==================================
         Markup burada DURUYOR, JS ile uretilmiyor: ilk boyamada aninda
         gorunsun, arada beyaz flash olmasin. #smooth-wrapper'in DISINDA
         (satir 360+) — ScrollSmoother'in transform'undan etkilenmesin.
         Surucu: assets/js/mailmyra-preloader.js
         ==================================================================== -->
    <div class="mml mml--glow" id="mm-preloader">
        <span class="mml-glow__orb mml-glow__orb--a"></span>
        <span class="mml-glow__orb mml-glow__orb--b"></span>

        <span class="mml-bar"><i></i><b></b></span>
        <div class="mml-tag"><s></s><span>LOADING</span></div>

        <div class="mml-glow">
            <p class="mml-glow__top">EMAIL SIGNATURES</p>

            <!-- mm: logo 8 dikey serit; her serit ayni SVG'nin kendi
                     dilimini gosteriyor, sirayla asagidan suzuluyor -->
            <h1 class="mml-glow__title" aria-label="Mailmyra">
                <span class="mml-glow__s" style="--n:0"><u></u></span>
                <span class="mml-glow__s" style="--n:1"><u></u></span>
                <span class="mml-glow__s" style="--n:2"><u></u></span>
                <span class="mml-glow__s" style="--n:3"><u></u></span>
                <span class="mml-glow__s" style="--n:4"><u></u></span>
                <span class="mml-glow__s" style="--n:5"><u></u></span>
                <span class="mml-glow__s" style="--n:6"><u></u></span>
                <span class="mml-glow__s" style="--n:7"><u></u></span>
            </h1>

            <p class="mml-glow__sub">BUILT ONCE · RENDERED EVERYWHERE</p>
        </div>
    </div>
    <script src="assets/js/mailmyra-preloader.js?v=mailmyra-0803-2"></script>
    <!-- mm: acilis ekrani (GLOW) — end -->

    <!-- Begin magic cursor -->
    <div id="magic-cursor">
        <div id="ball"></div>
    </div>
    <!-- End magic cursor -->

    <!-- mm: back to top → SAYFA ILERLEME dugmesi ========================
         Halka kaydirma ilerlemesini gosterir, ortadaki yuzde %100'de
         (ve hover'da) yukari oka doner. Temanin kabugu (id/class) KORUNDU:
         gorunme/gizlenme ve tiklama hala main.js → back_to_top() tarafindan
         yonetiliyor. Stil: assets/css/mailmyra-scrollprogress.css
         Surucu:  assets/js/mailmyra-scrollprogress.js
         ==================================================================== -->
    <div class="back-to-top-wrapper">
        <button id="back_to_top" type="button" class="back-to-top-btn" aria-label="Sayfa ilerlemesi — basa don">
            <svg class="mm-sp__ring" viewBox="0 0 54 54" aria-hidden="true">
                <!-- mm: r=24 → cevre 2πr = 150.796 (CSS'te elle yazili).
                         Kalin stroke viewBox disina tasmasin diye r kucultuldu. -->
                <circle class="mm-sp__track" cx="27" cy="27" r="24" />
                <circle class="mm-sp__shadow" cx="27" cy="27" r="24" />
                <circle class="mm-sp__bar" cx="27" cy="27" r="24" />
            </svg>
            <span class="mm-sp__face">
                <span class="mm-sp__num"><b>0</b><i>%</i></span>
                <svg class="mm-sp__arrow" width="18" height="11" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M11 6L6 1L1 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </button>
    </div>
    <!-- mm: back to top end -->
    <script src="assets/js/mailmyra-scrollprogress.js?v=mailmyra-0803-1" defer></script>

    <!-- mm: BUYUYEN MOBIL NAVIGASYON — temanin yandan kayan
