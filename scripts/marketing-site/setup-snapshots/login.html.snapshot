<script>
(function(){
        var shell = document.querySelector('[data-auth-shell]');
        var toggle = document.querySelector('[data-password-toggle]');
        var password = document.getElementById('login-password');

        if (toggle && password) {
            toggle.addEventListener('click', function(){
                var show = password.type === 'password';
                password.type = show ? 'text' : 'password';
                toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
                toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        }

        if (shell && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            shell.addEventListener('pointermove', function(event){
                shell.style.setProperty('--mm-auth-x', ((event.clientX / window.innerWidth) * 100).toFixed(1) + '%');
                shell.style.setProperty('--mm-auth-y', ((event.clientY / window.innerHeight) * 100).toFixed(1) + '%');
            }, { passive: true });
        }
    })();
</script>

<script>
    /* Uygulama uçları form gönderimini 303 ile buraya geri yollar; hata kodu
       query'de gelir, metni burada seçilir (kod makine tarafı, dil sitenin
       tarafı). Sunucu tarafı kontrolleri bunun yerine geçmez — bu yalnız
       gösterim. */
    (function () {
        var box = document.querySelector('[data-auth-error]');
        if (!box) return;

        var MESSAGES = {
            invalid_credentials: 'Email or password is incorrect.',
            rate_limited: 'Too many attempts. Please wait a few minutes and try again.',
            email_taken: 'This address already has an account. Try signing in instead.',
            weak_password: 'Password needs at least 10 characters, and not a common one.',
            invalid_email: 'That email address does not look right.',
            password_mismatch: 'The two passwords do not match.'
        };

        var code = new URLSearchParams(window.location.search).get('error');
        if (code) {
            /* textContent: kod kullanıcıdan gelen bir query değeri, asla
               innerHTML'e verilmez. */
            box.textContent = MESSAGES[code] || 'Something went wrong. Please try again.';
            box.hidden = false;
        }

        /* Şifre tekrarı: sunucu da bakıyor, ama kullanıcıya sayfayı terk
           ettirmeden söylemek daha iyi. */
        var form = document.querySelector('.mm-auth__form');
        var pass = form && form.querySelector('[name="password"]');
        var again = form && form.querySelector('[name="password_confirmation"]');
        if (form && pass && again) {
            form.addEventListener('submit', function (event) {
                if (pass.value === again.value) return;
                event.preventDefault();
                box.textContent = MESSAGES.password_mismatch;
                box.hidden = false;
                again.focus();
            });
        }
    })();
</script>

</body>

</html>
