    <!-- mm: SUREC PERDESI surucusu — mm-lightzone ile ayni desen:
             rAF + tek olcum, GSAP yok, mobilde de calisir. Bolumun ustu
             ekranin %88'inden %20'sine inerken ortu 1 → 0 erir. -->
    <script>
    (function () {
        var section = document.querySelector('.mm-steps');
        var veil = document.querySelector('.mm-steps__veil');
        if (!section || !veil) return;

        var queued = false;
        var last = -1;

        function clamp01(v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }

        function measure() {
            queued = false;
            var vh = window.innerHeight || document.documentElement.clientHeight;
            var top = section.getBoundingClientRect().top;
            var op = clamp01((top - vh * 0.20) / (vh * 0.68));
            if (Math.abs(op - last) < 0.003) return;
            last = op;
            veil.style.opacity = op.toFixed(3);
        }

        function queue() {
            if (queued) return;
            queued = true;
            requestAnimationFrame(measure);
        }

        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue, { passive: true });
        measure();
    })();
    </script>

    <!-- mm: HERO BASLIGI — harf harf bolme.
             Sadece isaretleme yapar, animasyon CSS'te (html.mm-ready).
             Her harf kendi --c sirasini tasir; bosluklar span'a girmez ki
             kelime araligi ve nowrap bozulmasin. Ekran okuyucu icin
             aria-label ile tam metin korunur. -->
    <script>
    (function () {
        var title = document.querySelector('.mm-hiw-title');
        if (!title || title.querySelector('span')) return;

        var text = title.textContent.trim();
        var out = '';
        var order = 0;

        for (var i = 0; i < text.length; i++) {
            var ch = text.charAt(i);
            if (ch === ' ') { out += ' '; continue; }
            out += '<span aria-hidden="true" style="--c:' + order + '">' + ch + '</span>';
            order++;
        }

        title.setAttribute('aria-label', text);
        title.innerHTML = out;
    })();
    </script>

    <!-- mm: HERO FARE ISIGI — imlecin yuzdelik konumunu hero'ya --mx/--my
             olarak yazar; boyama tamamen CSS'te. Yumusatma (lerp .14) sayesinde
             isik imleci gecikmeli takip eder, sertlik olmaz. rAF yalniz hareket
             varken doner, duruncan kendini kapatir. Dokunmatik/kalem cihazlarda
             hic kurulmaz (pointer: fine). -->
    <script>
    (function () {
        var hero = document.querySelector('.mm-hiw-hero');
        if (!hero) return;
        if (!window.matchMedia('(pointer: fine)').matches) return;

        var toX = 50, toY = 38, atX = 50, atY = 38, ticking = 0;

        function frame() {
            atX += (toX - atX) * 0.14;
            atY += (toY - atY) * 0.14;
            hero.style.setProperty('--mx', atX.toFixed(2) + '%');
            hero.style.setProperty('--my', atY.toFixed(2) + '%');
            ticking = (Math.abs(toX - atX) > 0.05 || Math.abs(toY - atY) > 0.05)
                ? requestAnimationFrame(frame)
                : 0;
        }

        hero.addEventListener('mousemove', function (event) {
            var box = hero.getBoundingClientRect();
            toX = ((event.clientX - box.left) / box.width) * 100;
            toY = ((event.clientY - box.top) / box.height) * 100;
            hero.classList.add('is-lit');
            if (!ticking) ticking = requestAnimationFrame(frame);
        }, { passive: true });

        hero.addEventListener('mouseleave', function () {
            hero.classList.remove('is-lit');
        });
    })();
    </script>

    <!-- mm: sayfa ici yumusak kaydirma (hero CTA → #how-start).
             Native anchor atlayisi ScrollSmoother'in transform'uyla yanlis
             yere dusuyor; smoother varsa onun API'siyle, yoksa (mobilde GSAP
             hic yuklenmiyor) native smooth ile kaydiriyoruz. -->
    <script>
    (function () {
        var HEADER_GAP = 92; /* sabit header kapsulunun altina birak */
        document.querySelectorAll('[data-mm-scrollto]').forEach(function (link) {
            link.addEventListener('click', function (event) {
                var hash = link.getAttribute('href') || '';
                if (hash.charAt(0) !== '#') return;
                var target = document.querySelector(hash);
                if (!target) return;
                event.preventDefault();
                var smoother = (window.ScrollSmoother && ScrollSmoother.get) ? ScrollSmoother.get() : null;
                if (smoother) {
                    smoother.scrollTo(target, true, 'top ' + HEADER_GAP + 'px');
                } else {
                    window.scrollTo({
                        top: target.getBoundingClientRect().top + window.pageYOffset - HEADER_GAP,
                        behavior: 'smooth'
                    });
                }
            });
        });
    })();
    </script>

    <!-- mm: index'in hero (E) scriptleri ve canli-baglama binder'i
             BILEREK alinmadi — onlar anasayfaya ozel. -->

<script>
/* ===== sayfa geneli: katman savunmaları + özel imleç ================= */
(function(){
  /* SAVUNMA: tema katmanları tıklamayı asla yutmasın.
     .body-overlay tam ekran + pointer-events:auto — görünür değilken bile
     yanlış durumda kalırsa içerikteki HER tıklamayı yutar (header ve alt
     çubuk daha yüksek katmanda olduğundan çalışmaya devam eder). */
  var mc = document.getElementById('magic-cursor');
  if (mc) mc.style.display = 'none';
  var pre = document.getElementById('preloader');
  if (pre) pre.style.pointerEvents = 'none';
  function guardOverlays(){
    document.querySelectorAll('.body-overlay').forEach(function(o){
      o.style.pointerEvents = o.classList.contains('opened') ? '' : 'none';
    });
  }
  guardOverlays();
  var mo = new MutationObserver(guardOverlays);
  document.querySelectorAll('.body-overlay').forEach(function(o){
    mo.observe(o, { attributes: true, attributeFilter: ['class', 'style'] });
  });
  document.addEventListener('click', function(){ setTimeout(guardOverlays, 60); }, true);

  /* OTOMATİK İYİLEŞTİRİCİ: builder'ın üstünde yabancı katman varsa yakala,
     etkisizleştir ve adını kaydet (mmdebug'da görünür) */
  var healed = [];
  function mmHeal(){
    var E = document.getElementById('hv-E');
    if (!E || !E.classList.contains('on')) return;
    ['[data-f="name"]', '.mmE-canvas .paper', '.mmE-rail button', '.mmE-tpl button', '.mmE-colors button']
      .forEach(function(sel){
        var el = E.querySelector(sel);
        if (!el) return;
        var r = el.getBoundingClientRect();
        if (!r.width) return;
        var top = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2);
        if (top && !top.closest('#smooth-content') && !top.closest('.hlab-switch')
            && !top.closest('.mmCur') && !top.closest('.mmnav') && !top.closest('.mmnav-veil')) {
          top.style.pointerEvents = 'none';
          var tag = top.tagName + (typeof top.className === 'string' && top.className ? '.' + top.className.split(' ')[0] : '');
          if (healed.indexOf(tag) < 0) healed.push(tag);
        }
      });
  }
  setInterval(mmHeal, 2000);

  /* ?mmdebug — imlecin/tıklamanın hangi elemana indiğini sol altta göster */
  if (location.search.indexOf('mmdebug') > -1) {
    var toast = document.createElement('div');
    toast.style.cssText = 'position:fixed;left:12px;bottom:70px;z-index:2147483647;padding:8px 12px;' +
      'border-radius:8px;background:#00102b;color:#89b4ef;font:11px ui-monospace,Menlo,monospace;' +
      'box-shadow:0 0 0 1px rgba(137,180,239,.4);pointer-events:none;max-width:70vw;';
    toast.textContent = 'mmdebug: fareyi gezdir / tıkla';
    document.body.appendChild(toast);
    function label(t){
      return t.tagName + ((typeof t.className === 'string' && t.className) ? '.' + t.className.split(' ').slice(0, 2).join('.') : '');
    }
    var lockUntil = 0;
    document.addEventListener('mousemove', function(e){
      if (Date.now() < lockUntil) return;
      toast.textContent = '~ ' + label(e.target) + (healed.length ? ' | temizlenen: ' + healed.join(',') : '');
    }, { passive: true });
    document.addEventListener('pointerdown', function(e){
      lockUntil = Date.now() + 2000;
      toast.textContent = '↓ TIK: ' + label(e.target) + ' @' + Math.round(e.clientX) + ',' + Math.round(e.clientY);
    }, true);
  }

  /* ÖZEL İMLEÇ: glow'lu turuncu OK (yalnız mouse'lu cihazlar) */
  if (!window.matchMedia('(pointer: fine)').matches) return;
  document.documentElement.classList.add('mm-cur');
  var cur = document.createElement('span');
  cur.className = 'mmCur hide';
  cur.innerHTML = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none">' +
    '<path d="M5 2.5 19.4 10.7 12.9 12.3 9.3 19.2 5 2.5Z" fill="#f2a573" stroke="#00102b" stroke-width="1.3" stroke-linejoin="round"/></svg>' +
    '<i class="car"></i>';
  document.body.appendChild(cur);
  var seen = false;
  document.addEventListener('mousemove', function(e){
    if (!seen) { seen = true; cur.classList.remove('hide'); }
    cur.style.transform = 'translate(' + e.clientX + 'px,' + e.clientY + 'px)';
    var t = e.target;
    var inter = t.closest && t.closest('a,button,select,[role="button"]');
    var isText = t.closest && t.closest('input,textarea,label');
    cur.classList.toggle('hov', !!inter);
    cur.classList.toggle('txt', !!isText && !inter);
  }, { passive: true });
  document.addEventListener('mousedown', function(){ cur.classList.add('down'); }, true);
  document.addEventListener('mouseup', function(){ cur.classList.remove('down'); }, true);
  document.addEventListener('mouseleave', function(){ cur.classList.add('hide'); seen = false; });
})();
</script>

<script>
/* Mobile and tablet footer accordion */
(function(){
  var footer = document.getElementById('mailmyra-footer');
  if (!footer) return;

  var media = window.matchMedia('(max-width: 991px)');
  var items = Array.prototype.slice.call(footer.querySelectorAll('.mm-footer__accordion-item'));
  var compact = null;

  function setItem(item, open){
    var trigger = item.querySelector('.mm-footer__section-head');
    var panel = item.querySelector('.mm-footer__accordion-panel');
    if (!trigger || !panel) return;
    item.classList.toggle('is-open', open);
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    panel.inert = !open;
  }

  function syncFooter(){
    var nextCompact = media.matches;
    if (compact === nextCompact) return;
    compact = nextCompact;
    items.forEach(function(item){
      var trigger = item.querySelector('.mm-footer__section-head');
      if (trigger) trigger.tabIndex = compact ? 0 : -1;
      setItem(item, compact ? false : true);
    });
  }

  items.forEach(function(item){
    var trigger = item.querySelector('.mm-footer__section-head');
    if (!trigger) return;
    function toggleItem(){
      if (!media.matches) return;
      var willOpen = !item.classList.contains('is-open');
      items.forEach(function(other){ setItem(other, false); });
      if (willOpen) setItem(item, true);
    }
    trigger.addEventListener('click', toggleItem);
    trigger.addEventListener('keydown', function(event){
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      toggleItem();
    });
  });

  if (media.addEventListener) media.addEventListener('change', syncFooter);
  else media.addListener(syncFooter);
  syncFooter();
})();
</script>


    <!-- JS here -->
    <!-- JS here -->

    <!-- mm: ozellik kartlari — Atropos ile 3B egilme. atropos.js zaten
         temanin kosullu yukleyicisinde var; burada yalniz hazir olunca
         baglaniyor. Kutuphane gelmezse kartlar duz kalir, icerik bozulmaz.
         `pointer: fine` yoksa (dokunmatik) hic kurulmuyor. -->
    <script>
      (function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        var tries = 0;
        (function boot() {
          if (typeof Atropos === 'undefined') {
            if (++tries > 40) return;
            return setTimeout(boot, 150);
          }
          document.querySelectorAll('.mm-cap__tilt').forEach(function (el) {
            Atropos({ el: el, activeOffset: 20, shadow: false, highlight: false, rotateXMax: 6, rotateYMax: 6 });
          });
        })();
      })();
    </script>


    <!-- mm: PRICING SURUCUSU.
             (1) koltuk hesaplayicisi — saf `koltuk x liste fiyati`, kademe YOK,
                 teklif kutusuna BAGLI DEGIL (esik mantigi motor isi).
             (2) SSS akordeonu — <details> yuksekligi native animate edilemez,
                 Web Animations API ile suruluyor (faq.html ile ayni desen).
             Rakamlar MM_PRICING'den okunur; sayfaya elle gomulmez. Ayni degerler
             HTML'e de yazildi, boylece JS kapaliyken de fiyat gorunur. -->
    <script>
    window.MM_PRICING = {"centsPerSeatYear": 100, "currency": "USD", "minSeats": 1, "maxSeats": 1000, "contactAbove": 500};
    (function () {
        var C = window.MM_PRICING;

        /* ---------------- hesaplayici ---------------- */
        var input = document.getElementById('mm-seats');
        if (input) {
            var total   = document.getElementById('mm-calc-total');
            var detail  = document.getElementById('mm-calc-detail');
            var contact = document.getElementById('mm-calc-contact');

            function money(cents) {
                return cents % 100 === 0
                    ? '$' + (cents / 100)
                    : '$' + (cents / 100).toFixed(2);
            }

            /* Bos / 0 / negatif / harf girisi -> sessizce min'e cek. Hata
               gostermiyoruz: kullanici yaziyorken kirmizi uyari cikarmak
               hesaplayicida gereksiz gurultu. */
            function normalise(raw) {
                var s = String(raw);
                /* Eksi isaretini ONCE yakala: rakam disini temizleyince "-5"
                   "5"e donusuyor ve negatif girdi 5 koltuk gibi okunuyordu. */
                var negative = /^\s*-/.test(s);
                var n = parseInt(s.replace(/[^0-9]/g, ''), 10);
                if (negative || !isFinite(n) || n < C.minSeats) n = C.minSeats;
                if (n > C.maxSeats) n = C.maxSeats;
                return n;
            }

            function render(seats) {
                var cents = seats * C.centsPerSeatYear;
                total.textContent = money(cents);
                detail.textContent = seats + (seats === 1 ? ' sender' : ' senders')
                    + ' × ' + money(C.centsPerSeatYear) + ' per year';
                if (contact) contact.hidden = seats < C.contactAbove;
            }

            /* Yazarken kutuya dokunma (kullanici "1" yazip "10" yazacakken
               1'e kilitlenmesin); sadece hesabi guncelle. Duzeltmeyi blur'da
               ve buton tiklamasinda yap. */
            input.addEventListener('input', function () {
                render(normalise(input.value));
            });
            input.addEventListener('blur', function () {
                var n = normalise(input.value);
                input.value = n;
                render(n);
            });

            Array.prototype.forEach.call(
                document.querySelectorAll('[data-mm-step]'), function (b) {
                    b.addEventListener('click', function () {
                        var n = normalise(input.value) + parseInt(b.getAttribute('data-mm-step'), 10);
                        n = normalise(n);
                        input.value = n;
                        render(n);
                        input.focus({ preventScroll: true });
                    });
                });

            render(normalise(input.value));
        }

        /* ---------------- calisma alani secici ----------------
           Kartlar ZATEN hepsi gorunur; bu secici sekme degil, bir vurgulayici.
           O yuzden role="tab" yok, aria-pressed'li dugmeler var. Sectigin
           kart one cikar, karsilastirma tablosunda ilgili sutun isaretlenir. */
        var segs = document.querySelectorAll('[data-mm-seg]');
        if (segs.length) {
            var segLine = document.getElementById('mm-seg-line');
            var LINES = {"pro": "For one person building and managing a single professional identity.", "team": "For a company that wants one approved signature across everybody.", "agency": "For an agency running signatures on behalf of separate clients."};

            function selectPlan(slug) {
                Array.prototype.forEach.call(segs, function (b) {
                    var on = b.getAttribute('data-mm-seg') === slug;
                    b.classList.toggle('is-on', on);
                    b.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
                Array.prototype.forEach.call(
                    document.querySelectorAll('[data-mm-plan]'), function (card) {
                        card.classList.toggle('is-on', card.getAttribute('data-mm-plan') === slug);
                    });
                Array.prototype.forEach.call(
                    document.querySelectorAll('[data-mm-col]'), function (cell) {
                        cell.classList.toggle('is-on', cell.getAttribute('data-mm-col') === slug);
                    });
                if (segLine && LINES[slug]) segLine.textContent = LINES[slug];
            }

            Array.prototype.forEach.call(segs, function (b) {
                b.addEventListener('click', function () {
                    selectPlan(b.getAttribute('data-mm-seg'));
                });
            });

            /* Sol/sag ok ile de gezilebilsin */
            document.querySelector('.mm-tariff__seg').addEventListener('keydown', function (e) {
                if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
                var list = Array.prototype.slice.call(segs);
                var at = list.indexOf(document.activeElement);
                if (at === -1) return;
                e.preventDefault();
                var next = list[(at + (e.key === 'ArrowRight' ? 1 : list.length - 1)) % list.length];
                next.focus();
                selectPlan(next.getAttribute('data-mm-seg'));
            });
        }

        /* ---------------- SSS akordeonu ---------------- */
        var list = document.getElementById('mm-tariff-faq-list');
        if (!list) return;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

        Array.prototype.forEach.call(list.querySelectorAll('details'), function (item) {
            var summary = item.querySelector('summary');
            var wrap = item.querySelector('.mm-tariff-faq__wrap');
            if (!summary || !wrap) return;
            var running = null;

            summary.addEventListener('click', function (event) {
                if (reduce.matches) return;              /* native davranis */
                event.preventDefault();
                if (running) { running.cancel(); running = null; }

                var opening = !item.open;
                if (opening) item.open = true;           /* olcebilmek icin ac */
                var full = wrap.scrollHeight;

                running = wrap.animate(
                    opening
                        ? [{ height: '0px', opacity: 0 }, { height: full + 'px', opacity: 1 }]
                        : [{ height: full + 'px', opacity: 1 }, { height: '0px', opacity: 0 }],
                    { duration: opening ? 340 : 260,
                      easing: opening ? 'cubic-bezier(.22,.61,.36,1)' : 'cubic-bezier(.4,0,.2,1)' });

                running.onfinish = function () {
                    if (!opening) item.open = false;
                    wrap.style.height = '';
                    running = null;
                };
                running.oncancel = function () { wrap.style.height = ''; };
            });
        });
    })();
    </script>


    <!-- mm: CALISMA ALANI SEKMELERI (mm-audience-driver).
             Sekmeler PANEL DEGISTIRMIYOR — uc kart da hep gorunur, sekme
             yalnizca ilgili karti VURGULUYOR. Sebep: fiyat ucunde de ayni,
             panel degistirmek ayni seyi iki kez soylemek olurdu.
             Bootstrap tab kullanilmiyor (mobilde iki rAF sonra async
             yukleniyor, o araliktaki dokunuslar oluyor). -->
    <script>
    (function () {
        var tabs = document.querySelectorAll('[data-mm-card]');
        if (!tabs.length) return;

        function select(btn) {
            var slug = btn.getAttribute('data-mm-card');
            Array.prototype.forEach.call(tabs, function (t) {
                var on = t === btn;
                t.classList.toggle('is-active', on);
                t.setAttribute('aria-selected', on ? 'true' : 'false');
                t.tabIndex = on ? 0 : -1;
            });
            Array.prototype.forEach.call(
                document.querySelectorAll('[data-mm-plan]'), function (card) {
                    card.classList.toggle('is-hot', card.getAttribute('data-mm-plan') === slug);
                });
        }

        Array.prototype.forEach.call(tabs, function (btn) {
            btn.addEventListener('click', function () { select(btn); });
        });

        tabs[0].parentNode.addEventListener('keydown', function (e) {
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
            var arr = Array.prototype.slice.call(tabs);
            var at = arr.indexOf(document.activeElement);
            if (at === -1) return;
            e.preventDefault();
            var next = arr[(at + (e.key === 'ArrowRight' ? 1 : arr.length - 1)) % arr.length];
            next.focus();
            select(next);
        });

        /* Acilista vurgulu kart Team; sekme de onunla eslesmeli. */
        var initial = document.querySelector('[data-mm-card="team"]');
        if (initial) select(initial);
    })();
    </script>


    <!-- mm: KARSILASTIRMA TABLOSU — satir etiketindeki chevron aciklamayi acar.
             Bootstrap collapse kullanilmiyor (mobilde iki rAF sonra async
             yukleniyor, o araliktaki dokunuslar oluyor). -->
    <script>
    (function () {
        var toggles = document.querySelectorAll('.mm-cmp__toggle');
        if (!toggles.length) return;
        Array.prototype.forEach.call(toggles, function (btn) {
            btn.addEventListener('click', function () {
                var open = btn.getAttribute('aria-expanded') === 'true';
                var desc = btn.parentNode.querySelector('.mm-cmp__desc');
                btn.setAttribute('aria-expanded', open ? 'false' : 'true');
                if (desc) desc.hidden = open;
            });
        });

        /* Sekmeler zaten karti vurguluyor; tabloda da ayni sutun isaretlensin. */
        var tabs = document.querySelectorAll('[data-mm-card]');
        Array.prototype.forEach.call(tabs, function (t) {
            t.addEventListener('click', function () {
                var slug = t.getAttribute('data-mm-card');
                Array.prototype.forEach.call(
                    document.querySelectorAll('.mm-cmp [data-mm-col]'), function (c) {
                        c.classList.toggle('is-on', c.getAttribute('data-mm-col') === slug);
                    });
            });
        });
    })();
    </script>

</body>

</html>
