<body class="tp-magic-cursor">

    <!-- mm: acilis ekrani (GLOW) — start ==================================
         Markup burada DURUYOR, JS ile uretilmiyor: ilk boyamada aninda
         gorunsun, arada beyaz flash olmasin. #smooth-wrapper'in DISINDA
         (satir 360+) — ScrollSmoother'in transform'undan etkilenmesin.
         Surucu: assets/js/mailmyra-preloader.js
         ==================================================================== -->
    <div class="mml mml--glow" id="mm-preloader">
        <span class="mml-glow__orb mml-glow__orb--a"></span>
        <span class="mml-glow__orb mml-glow__orb--b"></span>

        <span class="mml-bar"><i></i><b></b></span>
        <div class="mml-tag"><s></s><span>LOADING</span></div>

        <div class="mml-glow">
            <p class="mml-glow__top">EMAIL SIGNATURES</p>

            <!-- mm: logo 8 dikey serit; her serit ayni SVG'nin kendi
                     dilimini gosteriyor, sirayla asagidan suzuluyor -->
            <h1 class="mml-glow__title" aria-label="Mailmyra">
                <span class="mml-glow__s" style="--n:0"><u></u></span>
                <span class="mml-glow__s" style="--n:1"><u></u></span>
                <span class="mml-glow__s" style="--n:2"><u></u></span>
                <span class="mml-glow__s" style="--n:3"><u></u></span>
                <span class="mml-glow__s" style="--n:4"><u></u></span>
                <span class="mml-glow__s" style="--n:5"><u></u></span>
                <span class="mml-glow__s" style="--n:6"><u></u></span>
                <span class="mml-glow__s" style="--n:7"><u></u></span>
            </h1>

            <p class="mml-glow__sub">BUILT ONCE · RENDERED EVERYWHERE</p>
        </div>
    </div>
    <script src="assets/js/mailmyra-preloader.js?v=mailmyra-0803-2"></script>
    <!-- mm: acilis ekrani (GLOW) — end -->

    <!-- Begin magic cursor -->
    <div id="magic-cursor">
