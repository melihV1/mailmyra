<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpErrors>
      <remove statusCode="400" />
      <error statusCode="400" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\bad_request.html" />
      <remove statusCode="401" />
      <error statusCode="401" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\unauthorized.html" />
      <remove statusCode="403" />
      <error statusCode="403" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\forbidden.html" />
      <remove statusCode="404" />
      <error statusCode="404" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\not_found.html" />
      <remove statusCode="405" />
      <error statusCode="405" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\method_not_allowed.html" />
      <remove statusCode="406" />
      <error statusCode="406" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\not_acceptable.html" />
      <remove statusCode="407" />
      <error statusCode="407" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\proxy_authentication_required.html" />
      <remove statusCode="412" />
      <error statusCode="412" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\precondition_failed.html" />
      <remove statusCode="414" />
      <error statusCode="414" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\request-uri_too_long.html" />
      <remove statusCode="415" />
      <error statusCode="415" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\unsupported_media_type.html" />
      <remove statusCode="500" />
      <error statusCode="500" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\internal_server_error.html" />
      <remove statusCode="501" />
      <error statusCode="501" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\not_implemented.html" />
      <remove statusCode="502" />
      <error statusCode="502" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\bad_gateway.html" />
      <remove statusCode="503" />
      <error statusCode="503" path="C:\Inetpub\vhosts\mailmyra.com\error_docs\maintenance.html" />
    </httpErrors>
    <!-- ===== Mailmyra: uzantısız adresler =====================================
         Buradan aşağısı EL İLE eklendi (2026-08-18). Dosyanın geri kalanı
         Plesk'in kendi ürettiği hâli — hata sayfaları ve temp dizini oradan
         geliyor, DOKUNULMADI.

         ⚠️ Plesk bazı panel işlemlerinde bu dosyayı yeniden üretir ve o zaman
         aşağıdaki blok SİLİNİR. Site aniden uzantısız adreslerde 404 vermeye
         başlarsa ilk bakılacak yer burasıdır.

         Ne yapıyor: adres uzantısız görünür (/pricing), dosya diskte .html
         kalır. Uzantılı gelen istek kalıcı olarak temiz adrese yollanır ki
         aynı sayfa iki adresten servis edilip arama motorunda mükerrer
         içerik üretmesin.

         stopProcessing şart: IIS bir Rewrite'tan sonra kural setini baştan
         işletir, durdurulmazsa temiz adres -> .html -> temiz adres döngüsü.
         ======================================================================= -->
    <rewrite>
      <rules>

        <!-- /index.html -> /  (anasayfanın tek adresi olsun) -->
        <rule name="mm-index-to-root" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- /pricing.html -> /pricing -->
        <rule name="mm-html-to-clean" stopProcessing="true">
          <match url="^(.+)\.html$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- /pricing -> pricing.html (içeride, adres değişmeden).
             Koşullar: gerçek dosya/klasör istendiyse dokunma (assets/... ),
             ve yalnız karşılığı DİSKTE VAR OLAN adresleri çevir. -->
        <rule name="mm-clean-to-html" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- {REQUEST_FILENAME} DEĞİL: uzantısız adreste boş dönüyor ve
                 koşul hep patlıyordu (2026-08-18'de canlıda ölçüldü —
                 /pricing.html 301 veriyor ama /pricing 404 kalıyordu).
                 {DOCUMENT_ROOT} güvenilir. -->
            <add input="{DOCUMENT_ROOT}/{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>

      </rules>
    </rewrite>
    <tracing>
      <traceFailedRequests>
        <clear />
      </traceFailedRequests>
    </tracing>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\mailmyra.com\tmp" />
  </system.web>
</configuration>